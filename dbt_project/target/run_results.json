ch od wczoraj\n    WHERE cst_create_date > (SELECT MAX(cst_create_date) FROM \"DataWarehouse\".\"silver\".\"crm_cust_info\")\n", "relation_name": "\"DataWarehouse\".\"silver\".\"crm_cust_info\"", "batch_results": null, "overload_results": null}], "elapsed_time": 0.16393327713012695, "args": {"log_level_file": "debug", "require_ref_searches_node_package_before_root": false, "sqlparse": {"MAX_GROUPING_DEPTH": null, "MAX_GROUPING_TOKENS": null}, "use_colors": true, "latest_version_pointer_enabled_by_default": false, "invocation_command": "dbt run -s crm_cust_info", "show_all_deprecations": false, "log_path": "/opt/airflow/dbt_project/logs", "partial_parse": true, "show_resource_report": false, "allow_jinja_file_extensions": false, "introspect": true, "print": true, "log_format_file": "debug", "select": ["crm_cust_info"], "static_parser": true, "indirect_selection": "eager", "strict_mode": false, "require_source_and_semantic_model_names_without_spaces": false, "cache_selected_only": false, "defer": false, "state_modified_compare_vars": false, "use_catalogs_v2": false, "use_v2_parser": false, "require_unique_project_resource_names": false, "require_explicit_package_overrides_for_builtin_materializations": true, "require_valid_schema_from_generate_schema_name": false, "require_corrected_analysis_fqns": false, "require_batched_execution_for_custom_microbatch_strategy": true, "printer_width": 80, "log_format": "default", "profiles_dir": "/opt/airflow/dbt_project", "project_dir": "/opt/airflow/dbt_project", "validate_macro_args": true, "require_yaml_configuration_for_mf_time_spines": true, "skip_nodes_if_on_run_start_fails": true, "empty": false, "require_all_warnings_handled_by_warn_error": true, "state_modified_compare_more_unrendered_values": true, "send_anonymous_usage_stats": true, "require_resource_names_without_spaces": true, "require_sql_header_in_test_configs": false, "upload_to_artifacts_ingest_api": false, "use_colors_file": true, "enable_grouped_warn_error_parser