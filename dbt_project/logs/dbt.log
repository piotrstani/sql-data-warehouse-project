  create  table "DataWarehouse"."_test_failures"."dbt_expectations_expect_table__f54ba646b15da1f34349ef44861ee9ed"
  
  
    as
  
  (
    
    
  
    with a as (
        
    select
        
        count(*) as expression
    from
        "DataWarehouse"."silver"."crm_cust_info"
    

    ),
    b as (
        
    select
        
        count(*) * 1 as expression
    from
        "DataWarehouse"."bronze"."crm_cust_info"
    

    ),
    final as (

        select
            
            a.expression,
            b.expression as compare_expression,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0)) as expression_difference,
            abs(coalesce(a.expression, 0) - coalesce(b.expression, 0))/
                nullif(a.expression * 1.0, 0) as expression_difference_percent
        from
        
            a cross join b
        
    )
    -- DEBUG:
    -- select * from final
    select
        *
    from final
    where
        
        expression_difference > 0.0
        

  
  
  );
  
    
