    order_date,
    shipping_date,
    due_dt
from "DataWarehouse"."gold"."fact_sales"
where
    order_date > shipping_date  -- ANOMALIA: data wysyłki przed datą zamówienia
    or order_date > due_dt      -- ANOMALIA: data zamówienia po dacie wymagalności
  
  
  );
  
    
